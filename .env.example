# ─── Required ──────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host:5432/workpro
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
PI_API_KEY=your-pi-api-key
ADMIN_API_KEY=your-strong-admin-api-key

# ─── Optional ──────────────────────────────────────────────
FRONTEND_URL=https://cherry19899.github.io
NODE_ENV=production
PORT=3000

# Platform fee default (overridden by DB platform_settings table)
PLATFORM_FEE_PERCENT=2

# ─── Web Push (VAPID) ──────────────────────────────────────
# Generate once: set GENERATE_VAPID=1, start server, copy keys from logs, then remove GENERATE_VAPID.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@workpro.app

# ─── Dev/Testing ──────────────────────────────────────────
# SANDBOX_MODE=true          # Disables Pi payment verification (testnet only)
# RATE_LIMIT_BYPASS_KEY=     # Secret header to skip rate limits in CI
# GENERATE_VAPID=1           # Print VAPID keys to logs on startup (one-time setup)
# BACKUP_DIR=/tmp/backups    # Directory for pg_dump files
# BACKUP_KEEP=10             # Number of backup files to retain
# API_BASE_URL=https://workpro-api.onrender.com
