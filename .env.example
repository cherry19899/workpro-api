# Pi Network API Key (required for payment processing)
PI_API_KEY=your_pi_api_key_here

# Admin API Key (required for admin endpoints)
ADMIN_API_KEY=your_admin_api_key_here

# Frontend URL (for CORS)
FRONTEND_URL=https://cherry19899.github.io

# Server Port
PORT=3000

# Environment
NODE_ENV=production

# Optional: Database Path (default: /var/data/workpro.db)
# DB_PATH=/var/data/workpro.db
