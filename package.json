{
  "name": "workpro-api",
  "version": "3.0.0",
  "description": "WorkPro API - PostgreSQL",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:init": "node -e \"require('./db').initDb()\"",
    "test": "jest --testEnvironment node --runInBand",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.0",
    "multer": "^2.2.0",
    "node-fetch": "^2.6.9",
    "pg": "^8.11.0",
    "pi-backend": "^0.1.3",
    "socket.io": "^4.8.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^2.0.22",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testEnvironment": "node"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
